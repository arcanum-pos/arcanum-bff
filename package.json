{
  "name": "arcanum-bff",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc",
    "tail": "wrangler tail",
    "secret:put": "wrangler secret put",
    "kv:put": "wrangler kv:key put --binding=ARCANUM_SESSIONS",
