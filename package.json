    "kv:list": "wrangler kv:key list --binding=ARCANUM_SESSIONS"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.1"
  }
}
