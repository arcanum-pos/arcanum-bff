{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arcanum-bff",
	"workers_dev": true,
	"main": "src/index.ts",
	"compatibility_date": "2025-07-18",
	"dev": {
		"port": 8787,
		"inspector_port": 9887
	},
	"kv_namespaces": [
		{
			"binding": "ARCANUM_SESSIONS",
			"id": "9c4625a8e89b46a4a37bbd48bd1a2abe"
		}
	],
	"services": [
		{
			"binding": "ARCANUM_BACKEND_SERVICE",
			"service": "arcanum-backend"
		},
		{
			"binding": "ARCANUM_DEVICEHUB_SERVICE",
			"service": "arcanum-devicehub"
		},
		{
			// Every UI screen (admin portal at /console, kassa, settings, the
			// customer display, the SumUp simulator, the org/device chooser,
			// the login prompt, the device-grant QR page) lives here —
			// arcanum-webapp has nothing left to serve and no longer has a
			// binding.
			"binding": "ARCANUM_FRONTENDS_SERVICE",
			"service": "arcanum-frontends"
		}
	],
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"upload_source_maps": true,
	"vars": {
		// Replace with your new Auth0 tenant's domain, e.g. "your-tenant.eu.auth0.com".
		"AUTH0_DOMAIN": "auth.esvvzw.be",
		"SESSION_TTL": 604800,
		"FRONTEND_URL": "https://arcanum.kaboutersoft.be"
		// No AUDIENCE var: we deliberately don't request an Auth0-API-scoped access token.
		// Authorization (who can do what) is handled inside the app, not via Auth0 permissions/scopes.
		// COOKIE_DOMAIN and ALLOWED_ORIGINS are not needed: UI and API are same-origin behind this BFF.
	},
	"routes": [
		{
			"pattern": "arcanum.kaboutersoft.be",
			"custom_domain": true
		}
	]
}