{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wrk-questo-bff",
	"workers_dev": true,
	"main": "src/index.ts",
	"compatibility_date": "2025-07-18",
	"dev": {
		"port": 8787
	},
	"kv_namespaces": [
		{
			"binding": "QUESTO_SESSIONS",
			"id": "9c4625a8e89b46a4a37bbd48bd1a2abe"
		}
	],
	"services": [
		{
			"binding": "BANCONTACT_SERVICE",
			"service": "questo-bancontact-worker"
		},
		{
			"binding": "WEBAPP_SERVICE",
			"service": "questo-webapp"
		}
	],
	"observability": {
		"enabled": true
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"upload_source_maps": true,
	"vars": {
		// Replace with your new Auth0 tenant's domain, e.g. "your-tenant.eu.auth0.com".
		"AUTH0_DOMAIN": "auth.esvvzw.be",
		"SESSION_TTL": 604800,
		"FRONTEND_URL": "https://elewijtsepijl.esvvzw.be",
		// Forces login straight to this Auth0 connection, skipping Auth0's own
		// connection picker. Must also be disabled/removed from the "Social" side
		// (Applications > this app > Connections tab) if you want to guarantee no
		// one can bypass this by crafting their own /authorize URL with a
		// different connection param — this var alone only changes what the
		// BFF's own login link does, not what Auth0 accepts for this client_id.
		"OAUTH_CONNECTION": "googleworkspace"
		// No AUDIENCE var: we deliberately don't request an Auth0-API-scoped access token.
		// Authorization (who can do what) is handled inside the app, not via Auth0 permissions/scopes.
		// COOKIE_DOMAIN and ALLOWED_ORIGINS are not needed: UI and API are same-origin behind this BFF.
	},
	"routes": [
		{
			"pattern": "elewijtsepijl.esvvzw.be",
			"custom_domain": true
		}
	]
}