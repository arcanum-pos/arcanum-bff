# Copy this file to .dev.vars and fill in your values.
# .dev.vars is git-ignored and must never be committed.

OAUTH_CLIENT_ID=your-auth0-client-id
OAUTH_CLIENT_SECRET=your-auth0-client-secret

# Overrides the production FRONTEND_URL (set in wrangler.jsonc) for local dev.
# The BFF is its own frontend now (single front door), so this is just where
# `wrangler dev` serves this Worker.
FRONTEND_URL=http://localhost:8787

# Local `wrangler dev` URL for the arcanum-backend Worker (run it on a different port).
BANCONTACT_LOCAL_URL=http://localhost:8789

# Local `wrangler dev` URL for the arcanum-devicehub Worker (run it on a different port).
DEVICEHUB_LOCAL_URL=http://localhost:8790

# Local `wrangler dev` URL for the arcanum-frontends Worker (run it on a different port).
CONSOLE_LOCAL_URL=http://localhost:8791

# Authorizes calls to worker's internal-only identity-provider-resolution
# route — must match worker's own BFF_INTERNAL_KEY.
BFF_INTERNAL_KEY=change-me-to-a-long-random-value
